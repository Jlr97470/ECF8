{% extends 'base.html.twig' %}

{% block title %}Liste des thèmes{% endblock %}

{% block content %}
{% include 'helpers/form/_delete_form.html.twig' %}
    <section>
        <div class="container px-4 px-lg-5 py-3">
            {# Titre de la page #}
            <div class="row">
                <div class="col-lg-12">
                    <h1 class="page-header">Liste des Thèmes</h1>
                    <p class="lead">Voici la liste de tous les thèmes.</p>
                </div>
            </div>
            <div class="row" role="alert">
                <div class="col-xs-9 col-sm-10"></div>

                <div class="col-xs-3 col-sm-2">
                    {% if (app.user and 'ROLE_ADMIN' in app.user.roles) %}
                    <a href="{{ path('app_theme_add') }}" role="button" class="btn btn-info text-right">
                        <i class="fa fa-plus fa-fw"></i> Ajouter
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>  
        <div class="container px-4 px-lg-5 py-3">
            {{ knp_pagination_filter(pagination, {'theme.libelle': 'Libellé'}) }}
        </div>                  
         <div class="container px-4 px-lg-5 py-3">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col" colspan="2" {% if pagination.isSorted('theme.libelle') %} class="sorted"{% endif %}>
                            {{ knp_pagination_sortable(pagination, 'Libellé', 'theme.libelle') }}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for theme in pagination %}
                    <tr>
                        <th scope="row">
                            <a href="{{ path('app_theme_index', {'id': theme.themeid}) }}" class="fw-bolder">{{ theme.libelle|nl2br }}</a>
                        </th>
                        <td>
                            {% if (app.user and 'ROLE_ADMIN' in app.user.roles) %}
                            <a href="JavaScript:InitDialog(YesNo,'Confirmation','Voulez-vous supprimer ?',() => { if (document.getElementById('diadialog').returnValue=='Yes') {document.getElementById('delete').action='{{ path('app_theme_remove', {'id': theme.themeid}) }}';document.getElementById('_token').value='{{ csrf_token('delete' ~ theme.themeid) }}';document.getElementById('delete').submit();};});diadialog.showModal();" role="button" class="btn btn-danger">Supprimer</a>
                            <a href="{{ path('app_theme_edit', {'id': theme.themeid}) }}" role="button" class="btn btn-info">Modifier</a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {# display navigation #}
            <div class="navigation">
                {{ knp_pagination_render(pagination) }}
            </div>             
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
{% endblock %}

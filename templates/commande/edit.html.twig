{% extends 'base.html.twig' %}

{% block title %}Commande{% endblock %}

{% block content %}
    <section>
        <div class="container px-4 px-lg-5 py-3">
            {# Titre de la page #}
            <div class="row">
                <div class="col-lg-12">
                    <h1 class="page-header">{% if mode == 'new' %}Ajout{% else %}Modification{% endif %} - Commande</h1>
                </div>
            </div>
        </div>
        <div class="container px-4 px-lg-5 py-3">

            {# ------------------------- #}
            {#      INFOS GÉNÉRALES      #}
            {# ------------------------- #}
            {% if mode == 'update' %}
            <div class="row" >
                <h4 class="col-lg-12">
                    <a data-group data-toggle="collapse" href="#info"><i class="fa fa-angle-double-down fa-fw"></i> Informations générales</a>
                </h4>
            </div>
            {% endif %}
        </div>
        <div class="container px-4 px-lg-5 py-3">
        {% if (app.user and 'ROLE_USER' in app.user.roles) %}
            <p><strong>Date de la commande : </strong><br>{{ commande.datecommande|date('d/m/Y') }}</p>
        {% endif %}
            <p><strong>Menu : </strong><br>
        {% if commande.menuId %}
            <a href="{{ path('app_menu_index', {'id': commande.menuId.menuid}) }}" class="fw-bolder">{{ commande.menuId.titre }}</a>
            <p><strong>Nombre de personnes minimum : </strong><br>{{ commande.menuId.nombrepersonneminimum }}</p>
            <p><strong>Prix par personne : </strong><br>{{ commande.menuId.prixparpersonne }} €</p>
            <p><strong>Régime : </strong><br>{{ commande.menuId.regime }}</p>
            <p><strong>Quantité restante : </strong><br>
                {% if commande.menuId.quantiterestante > 0 %}
                    {{ commande.menuId.quantiterestante }}
                {% else %}
                    <span class="text-danger">Rupture de stock</span>
                {% endif %}
            </p>
            <p>
                <strong>Description : </strong><br>{{ commande.menuId.description|nl2br }}
            </p>                  
        {% else %}
                    Aucun menu associé
        {% endif %}
            </p>
        {% if (app.user and 'ROLE_ADMIN' in app.user.roles) or (app.user and 'ROLE_USE' in app.user.roles) %}
            <p><strong>Client : </strong><br><a href="{{path('app_utilisateur_index',{'id':commande.utilisateurId.utilisateurid}) }}"  class="fw-bolder"> {{ commande.utilisateurId.prenom }} {{ commande.utilisateurId.nom }}</a></p>
        {% else %}
            <p><strong>Client : </strong><br>{{ commande.utilisateurId.prenom }} {{ commande.utilisateurId.nom }}</p>
        {% endif %}
            <p><strong>Adresse : </strong><br>{{ commande.utilisateurId.adressepostal }}</p>
            <p><strong>Ville : </strong><br>{{ commande.utilisateurId.ville }}</p>
            <p><strong>Pays : </strong><br>{{ commande.utilisateurId.pays }}</p>
            <p><strong>Telephone : </strong><br>{{ commande.utilisateurId.telephone }}</p>
        {% if (app.user and 'ROLE_USER' in app.user.roles) %}
            <p><strong>Statut : </strong><br>{{ commande.statut }}</p>
        {% endif %}
        </div>
        <div class="container px-4 px-lg-5 py-3">
            <div class="row" role="alert">
                <div class="col-xs-9 col-sm-10">
                    <a href="{{ path('app_commande_liste') }}" role="button" class="btn btn-secondary">Retour à la liste</a>
                </div>
            </div>        
        </div>
        <div class="container px-4 px-lg-5 py-3">
            {{ form_start(form, {'method': 'POST', 'attr': {'novalidate': 'novalidate' }} ) }}

            <div id="info" class="panel-collapse">
                {% if (app.user and 'ROLE_ADMIN' in app.user.roles) or (app.user and 'ROLE_USE' in app.user.roles) %}
                <div class="input-field col s12 m6 l6 offset-m3 offset-l3">        
                {{ include('helpers/form/group.html.twig', {
                            'field': form['numerocommande'], 'attr': {'attr':{'size': '30'}}
                        }) }}
                </div>
                <div class="input-field col s12 m6 l6 offset-m3 offset-l3">        
                {{ include('helpers/form/group.html.twig', {
                            'field': form['datecommande'], 'attr': {'attr':{'size': '30', 'class': 'datePicker'}}
                        }) }}   
                </div>
                {% endif %}
                <div class="input-field col s12 m6 l6 offset-m3 offset-l    3">        
                {{ include('helpers/form/group.html.twig', {
                            'field': form['dateprestation'], 'attr': {'attr':{'size': '30', 'class': 'datePicker'}}
                        }) }}
                </div>
                 <div class="input-field col s12 m6 l6 offset-m3 offset-l3">        
                {{ include('helpers/form/group.html.twig', {
                            'field': form['heurelivraison'], 'attr': {'attr':{'size': '30'}}
                        }) }}
                </div>
                <div class="input-field col s12 m6 l6 offset-m3 offset-l3">        
                {{ include('helpers/form/group.html.twig', {
                            'field': form['nombrepersonne'], 'attr': {'attr':{'size': '30'}}
                        }) }}
                </div>  
                <div class="input-field col s12 m6 l6 offset-m3 offset-l3">        
                {{ include('helpers/form/group.html.twig', {
                            'field': form['prixmenu'], 'attr': {'attr':{'size': '30', 'class': 'prixcategory'}}
                        }) }}  
                        <p class="text-muted">Le prix du menu est calculé automatiquement en fonction du nombre de personnes et du prix par personne du menu sélectionné. Si le nombre de personnes dépasse le nombre minimum+5 requis pour bénéficier d'une réduction, une remise de 10% est appliquée sur le prix total du menu.</p> 
                </div>
                <div class="input-field col s12 m6 l6 offset-m3 offset-l3">        
                {{ include('helpers/form/group.html.twig', {
                            'field': form['prixlivraison'], 'attr': {'attr':{'size': '30', 'class': 'prixcategory'}}
                        }) }}   
                </div>
                {% if (app.user and 'ROLE_ADMIN' in app.user.roles) or (app.user and 'ROLE_USE' in app.user.roles) %}      
                <div class="input-field col s12 m6 l6 offset-m3 offset-l3">        
                {{ include('helpers/form/group.html.twig', {
                            'field': form['statut'], 'attr': {'attr':{'rows': '8', 'cols': '30'}}
                        }) }}
                </div>
                {% endif %}
                <div class="input-field col s12 m6 l6 offset-m3 offset-l3">        
                {{ include('helpers/form/group.html.twig', {
                            'field': form['pretmateriel'], 'attr': {'attr':{}}
                        }) }}
                </div>
                {% if (app.user and 'ROLE_ADMIN' in app.user.roles) or (app.user and 'ROLE_USE' in app.user.roles) %}
                <div class="input-field col s12 m6 l6 offset-m3 offset-l3">        
                {{ include('helpers/form/group.html.twig', {
                            'field': form['restitutionmateriel'], 'attr': {'attr':{}}
                        }) }}
                </div>
                {% endif %}
            </div>
            <div class="row">
                {% if not form.vars.valid %}
                <div class="col-md-8">
                    <i class="fa fa-exclamation-triangle fa-fw"></i>
                    <i class="error">
                        Le formulaire contient des erreurs. Vérifiez les différentes rubriques.
                    </i>
                </div>
                {% else %}
                    <div class="col-md-8"></div>
                {% endif %} 
                <div class="col-md-8 text-right">
                    {{ form_widget(form.submit, { 'attr': {'class': 'btn btn-info'} }) }}
                </div>
            </div>
            {{ form_widget(form) }}
            {{ form_end(form) }}
        </div>
    </section>    
{% endblock %}
{% block stylesheets %}
{% endblock %}
{% block formscripts %}
<script type="text/javascript">
    document.getElementById('commande_nombrepersonne').addEventListener('change', function() {

        if ({{ commande.menuId.nombrepersonneminimum }} + 5 <= document.getElementById('{{ form['nombrepersonne'].vars.id }}').value) {
            document.getElementById('{{ form['prixmenu'].vars.id }}').value = Math.round({{ commande.menuId.prixparpersonne }} * document.getElementById('{{ form['nombrepersonne'].vars.id }}').value*0.9*100)/100;
            document.getElementById('{{ form['prixlivraison'].vars.id }}').value=5;  
        }
        else {  
            document.getElementById('{{ form['prixmenu'].vars.id }}').value = Math.round({{ commande.menuId.prixparpersonne }} * document.getElementById('{{ form['nombrepersonne'].vars.id }}').value*100)/100;
            document.getElementById('{{ form['prixlivraison'].vars.id }}').value=5;  
        };         
    });
</script> 
{% endblock %}

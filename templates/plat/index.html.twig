{% extends 'base.html.twig' %}

{% block title %}{{ plat.titreplat }} {% endblock %}

{% block content %}
{% include 'helpers/form/_delete_form.html.twig' %}
    <section>               
         <div class="container px-4 px-lg-5 py-3">
            {# Titre de la page #}
            <div class="row">
                <div class="col-lg-12">
                    <h1 class="page-header">{{ plat.titreplat }}</h1>
                </div>
            </div>
        </div>
        <div class="container  px-4 px-lg-5 my-5">
            <p><strong>Photo : </strong></p> 
            <p><img src="{{ path('app_plat_photo', {'id': plat.platid}) }}" alt="{{ plat.titreplat }}" class="img-fluid"></p>
        </div>
        <div class="container px-4 px-lg-5 py-3">
            <div class="row" role="alert">
                <div class="col-xs-9 col-sm-10">
                    <a href="{{ path('app_plat_liste') }}" role="button" class="btn btn-secondary">Retour à la liste</a>
                </div>
                {% if (app.user and 'ROLE_ADMIN' in app.user.roles) or (app.user and 'ROLE_USE' in app.user.roles) %}
                <div class="col-xs-3 col-sm-2">      
                    <a href="JavaScript:InitDialog(YesNo,'Confirmation','Voulez-vous supprimer ?',() => { if (document.getElementById('diadialog').returnValue=='Yes') {document.getElementById('delete').action='{{ path('app_plat_remove', {'id': plat.platid}) }}';document.getElementById('_token').value='{{ csrf_token('delete' ~ plat.platid) }}';document.getElementById('delete').submit();};});diadialog.showModal();" role="button" class="btn btn-danger">Supprimer</a>
                    <a href="{{ path('app_plat_edit', {'id': plat.platid}) }}" role="button" class="btn btn-info">Modifier</a>
                </div>
                {% endif %}
            </div>        
        </div> 
        <div class="container px-4 px-lg-5 py-3">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col" colspan="2">
                            <h2>Allergènes associés : </h2>
                            <p class="text-muted">Nombre d'allergènes associés : {{ allergenes|length }}</p>
                            <p class="text-muted">Liste des allergènes associés à ce plat. {% if (app.user and 'ROLE_ADMIN' in app.user.roles) or (app.user and 'ROLE_USE' in app.user.roles) %}Cliquez sur le titre d'un allergène pour voir les détails ou utilisez les boutons pour supprimer des allergènes à ce plat.{% endif %}</p>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for allergene in allergenes %}
                    <tr>
                        <th scope="row">
                            <a href="{{ path('app_allergene_index', {'id': allergene.allergeneid}) }}" class="fw-bolder">{{ allergene.libelle }}</a>
                        </th>                         
                        <td>
                            {% if (app.user and 'ROLE_ADMIN' in app.user.roles) or (app.user and 'ROLE_USE' in app.user.roles) %}
                            <a href="JavaScript:InitDialog(YesNo,'Confirmation','Voulez-vous supprimer ?',() => { if (document.getElementById('diadialog').returnValue=='Yes') {document.getElementById('delete').action='{{ path('app_plat_allergeneremove', {'idplat': plat.platid, 'idallergene': allergene.allergeneid}) }}';document.getElementById('_token').value='{{ csrf_token('delete' ~ allergene.allergeneid) }}';document.getElementById('delete').submit();};});diadialog.showModal();" class="btn btn-danger">Supprimer allergène</a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if (app.user and 'ROLE_ADMIN' in app.user.roles) or (app.user and 'ROLE_USE' in app.user.roles) %}
        <div class="container px-4 px-lg-5 py-3">
            <div class="row">
                <div class="col-lg-12">
                    <h2>Liste des Allergènes</h2>
                    <p class="text-muted">Nombre total d'allergènes : {{ pagination.getTotalItemCount }}</p>
                    <p class="text-muted">Liste de tous les allergènes disponibles. Cliquez sur le titre d'un allergène pour voir les détails ou utilisez les boutons pour ajouter des allergènes à ce plat.</p>
                </div>
            </div>        
        </div>
        <div class="container px-4 px-lg-5 py-3">
            {{ knp_pagination_filter(pagination, {'allergene.libelle': 'Libellé'}) }}
        </div>         
        <div class="container px-4 px-lg-5 py-3">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col" colspan="2" {% if pagination.isSorted('allergene.libelle') %} class="sorted"{% endif %}>
                            {{ knp_pagination_sortable(pagination, 'Libellé', 'allergene.libelle') }}
                        </th>                    
                    </tr>
                </thead>
                <tbody>
                    {% for allergene in pagination %}
                    <tr>
                        <th scope="row">
                            <a href="{{ path('app_allergene_index', {'id': allergene.allergeneid}) }}" class="fw-bolder">{{ allergene.libelle }}</a>
                        </th>                        
                        <td>
                            <a href="{{path('app_plat_allergeneadd',{'idplat':plat.platid,'idallergene':allergene.allergeneid})}}" class="btn btn-success">Ajouter allergène</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {# display navigation #}
            <div class="navigation">
                {{ knp_pagination_render(pagination) }}
            </div>             
        </div>
        {% endif %}
    </section>
{% endblock %}

{% block stylesheets %}
{% endblock %}

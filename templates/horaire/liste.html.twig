{% extends 'base.html.twig' %}

{% block title %}Liste des aviss{% endblock %}

{% block content %}
{% include 'helpers/form/_delete_form.html.twig' %}
    <section>
        <div class="container px-4 px-lg-5 py-3">
            {# Titre de la page #}
            <div class="row">
                <div class="col-lg-12">
                    <h1 class="page-header">Liste des Horaires</h1>
                    <p class="lead">Voici la liste de tous les horaires.</p>
                </div>
            </div>

            <div class="row" role="alert">
                <div class="col-xs-9 col-sm-10"></div>

                <div class="col-xs-3 col-sm-2">
                    {% if (app.user and 'ROLE_ADMIN' in app.user.roles) or (app.user and 'ROLE_USE' in app.user.roles) %}
                    <a href="{{ path('app_horaire_add') }}" role="button" class="btn btn-info text-right">
                        <i class="fa fa-plus fa-fw"></i> Ajouter
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="container px-4 px-lg-5 py-3">
            {{ knp_pagination_filter(pagination, {'horaire.jour': 'Jour','horaire.heure_ouverture': 'Heure ouv.','horaire.heure_fermeture': 'Heure fermeture'}) }}
        </div>                    
         <div class="container px-4 px-lg-5 py-3">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col" {% if pagination.isSorted('horaire.jour') %} class="sorted"{% endif %}>
                            {{ knp_pagination_sortable(pagination, 'Jour', 'horaire.jour') }}
                        </th>
                        <th scope="col" {% if pagination.isSorted('horaire.heure_ouverture') %} class="sorted"{% endif %}>
                            {{ knp_pagination_sortable(pagination, 'Heure d\'ouverture', 'horaire.heure_ouverture') }}
                        </th>
                        <th colspan="2" scope="col" {% if pagination.isSorted('horaire.heure_fermeture') %} class="sorted"{% endif %}>
                            {{ knp_pagination_sortable(pagination, 'Heure de fermeture', 'horaire.heure_fermeture') }}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for horaire in pagination %}
                    <tr>
                        <th scope="row">
                            <a href="{{ path('app_horaire_index', {'id': horaire.horaireid}) }}" class="fw-bolder">{{ horaire.jour|nl2br }}</a>
                        </th>
                        <td>
                            {{ horaire.heureouverture|nl2br }}
                        </td>
                        <td>
                            {{ horaire.heurefermeture|nl2br }}
                        </td>
                        <td>
                            {% if (app.user and 'ROLE_ADMIN' in app.user.roles) or (app.user and 'ROLE_USE' in app.user.roles) %}
                            <a href="JavaScript:InitDialog(YesNo,'Confirmation','Voulez-vous supprimer ?',() => { if (document.getElementById('diadialog').returnValue=='Yes') {document.getElementById('delete').action='{{ path('app_horaire_remove', {'id': horaire.horaireid}) }}';document.getElementById('_token').value='{{ csrf_token('delete' ~ horaire.horaireid) }}';document.getElementById('delete').submit();};});diadialog.showModal();" role="button" class="btn btn-danger">Supprimer</a>
                            <a href="{{ path('app_horaire_edit', {'id': horaire.horaireid}) }}" role="button" class="btn btn-info">Modifier</a>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {# display navigation #}
            <div class="navigation">
                {{ knp_pagination_render(pagination) }}
            </div>             
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
{% endblock %}
